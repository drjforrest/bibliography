# Backend Production Environment for hero-evidence-library
# This file will be copied to backend/.env on the production server

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bibliography_db"

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY="your_secret_key_here_use_openssl_rand_hex_32"
AUTH_TYPE="clerk"

# Embedding Model - Using sentence-transformers (reliable)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Reranker
RERANKERS_MODEL_NAME="flashrank"
RERANKERS_MODEL_TYPE="flashrank"

# LLM configuration
FAST_LLM="nvidia-nemotron-3-nano-30b-a3b-mlx"
FAST_LLM_API_BASE="http://192.168.1.81:1234/v1"
LONG_CONTEXT_LLM="gpt-4"
STRATEGIC_LLM="gpt-4"

# File storage - Production paths
PDF_STORAGE_ROOT="/Users/jforrest/production/hero-evidence-library/data/pdfs"
WATCHED_FOLDER="/Users/jforrest/production/hero-evidence-library/data/watched"

# Optional API keys
OPENAI_API_KEY=""
UNSTRUCTURED_API_KEY=""
FIRECRAWL_API_KEY=""

# LangSmith (optional)
LANGSMITH_TRACING=false

# Redis configuration for migration tracking
REDIS_URL="redis://localhost:6379/0"

# DEVONthink MCP Backend
DEVONTHINK_MCP_BACKEND="real"

# Ollama configuration for lay summary generation
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:8b-instruct-q4_K_M"
OLLAMA_TIMEOUT=120

# Clerk Authentication (Set this on the server - DO NOT commit real secret)
CLERK_SIGNING_SECRET=your_clerk_signing_secret_here
